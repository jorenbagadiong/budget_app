# NextAuth / Auth.js Configuration
# Generate with: openssl rand -base64 33
AUTH_SECRET=changeme_to_a_secure_random_32_character_string_here
AUTH_TRUST_HOST=true
# Optional: Set NEXTAUTH_URL if deploying to a fixed production domain
# NEXTAUTH_URL=https://yourdomain.com

# Google OAuth Credentials (Google Cloud Console > Credentials > OAuth 2.0 Client IDs)
# Required scopes: openid, email, profile
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Google Apps Script Backend (API Layer over Google Sheets)
# Deploy Apps Script Web App from /apps-script/Code.gs
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
APPS_SCRIPT_SHARED_SECRET=your_apps_script_shared_secret_key_min_32_chars

# Data Storage Mode
# Set to 'true' to use the local in-memory/file storage engine for development/testing
# Set to 'false' to communicate with the live Google Apps Script Web App
USE_MOCK_STORAGE=true
